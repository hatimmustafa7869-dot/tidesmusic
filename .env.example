# ==============================================================
# Tides Music - Hostinger & Production Environment Variables
# ==============================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Authentication & Security
# IMPORTANT: Generate a 32+ character random string for production
# You can generate one via terminal: openssl rand -hex 32
JWT_SECRET=soundflow-production-secret-change-this-to-a-random-secure-string

# Database Configuration (SQLite file location)
DATABASE_PATH=soundflow.db

# YouTube Data API Key
# Optional: Default fallback is included, but providing your own key from 
# Google Cloud Console (YouTube Data API v3) guarantees high search quota.
YOUTUBE_API_KEY=AIzaSyBD3kLZd4PMOhNKS0k6qQOlig_svmqmtGY

# Cache TTL (in seconds) for resolved audio stream URLs (default: 3600 = 1 hour)
STREAM_CACHE_TTL=3600
